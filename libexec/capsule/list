#!/usr/bin/env bash
set -euo pipefail

[[ -n "${CAPSULE_ROOT:-}" ]] || {
  printf 'capsule: error: run this command through capsule\n' >&2
  exit 1
}

# shellcheck source=lib/capsule/common.sh
# shellcheck disable=SC1091
source "$CAPSULE_ROOT/lib/capsule/common.sh"

CAPSULE_LIST_ROWS=()

usage() {
  cat <<'EOF'
Usage: capsule list [options]

Options:
  -r, --remote HOST[:PORT]  Query a remote Docker host over SSH.
      --runtime RUNTIME     Query auto, docker, podman, or apple
                            (default: auto; apple only on macOS).
  -h, --help                Show this help message.

Environment:
  CAPSULE_REMOTE   Remote HOST[:PORT] target.
  CAPSULE_RUNTIME  Runtime to query: auto, docker, podman, or apple.
EOF
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--remote)
        if [[ $# -lt 2 ]] || [[ "${2:-}" == -* ]]; then
          die '--remote requires HOST[:PORT]'
        fi
        parse_remote_target "$2"
        shift 2
        ;;
      --remote=*)
        parse_remote_target "${1#--remote=}"
        shift
        ;;
      --runtime)
        if [[ $# -lt 2 ]] || [[ "${2:-}" == -* ]]; then
          die '--runtime requires podman, docker, apple, or auto'
        fi
        set_runtime_selection "$2"
        shift 2
        ;;
      --runtime=*)
        set_runtime_selection "${1#--runtime=}"
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown list option: $1"
        ;;
    esac
  done
}

# Name the Docker endpoint selected by its environment or active context.
docker_list_target() {
  local endpoint=""

  if [[ -n "${DOCKER_CONTEXT:-}" ]]; then
    if ! endpoint="$(docker context inspect "$DOCKER_CONTEXT" \
      --format '{{(index .Endpoints "docker").Host}}' 2>/dev/null)"; then
      endpoint="context:$DOCKER_CONTEXT"
    fi
  elif [[ -n "${DOCKER_HOST:-}" ]]; then
    endpoint="$DOCKER_HOST"
  else
    endpoint="$(docker context inspect \
      --format '{{(index .Endpoints "docker").Host}}' 2>/dev/null || true)"
  fi

  case "$endpoint" in
    ''|unix://*|npipe://*|fd://*) printf '%s\n' local ;;
    *) printf '%s\n' "$endpoint" ;;
  esac
}

# Read one value from the container's configured environment.
container_env_value() {
  local engine="$1"
  local container_id="$2"
  local variable="$3"

  "$engine" inspect --format \
    '{{range .Config.Env}}{{println .}}{{end}}' \
    "$container_id" 2>/dev/null | awk -v prefix="${variable}=" '
    !found && index($0, prefix) == 1 {
      value = substr($0, length(prefix) + 1)
      found = 1
    }
    END {
      if (found) print value
    }
  '
}

# Resolve a numeric host user locally or through the configured SSH target.
resolve_host_user() {
  local host_uid="$1"
  local resolve_local="${2:-1}"
  local resolved_user=""

  if [[ ! "$host_uid" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$host_uid"
    return
  fi

  if [[ -n "$REMOTE_HOST" ]]; then
    resolved_user="$(run_remote_ssh \
      "id -nu $host_uid 2>/dev/null || true")"
  elif [[ "$resolve_local" -eq 0 ]]; then
    resolved_user="$host_uid"
  else
    resolved_user="$(id -nu "$host_uid" 2>/dev/null || true)"
  fi

  printf '%s\n' "${resolved_user:-$host_uid}"
}

# Print the collected tab-separated rows as an aligned table.
print_capsule_list() {
  {
    printf 'TARGET\tRUNTIME\tUSER\tID\tNAME\tUPTIME'
    printf '\tIMAGE\tSTATUS\tPORTS\tHOST_DIR\n'
    if [[ "${#CAPSULE_LIST_ROWS[@]}" -gt 0 ]]; then
      printf '%s\n' \
        ${CAPSULE_LIST_ROWS[@]+"${CAPSULE_LIST_ROWS[@]}"}
    fi
  } | awk -F '\t' '
    {
      rows = NR
      if (NF > columns) columns = NF
      for (column = 1; column <= NF; column++) {
        value[NR, column] = $column
        if (length($column) > width[column]) width[column] = length($column)
      }
    }
    END {
      for (row = 1; row <= rows; row++) {
        for (column = 1; column < columns; column++) {
          printf "%-*s  ", width[column], value[row, column]
        }
        print value[row, columns]
      }
    }
  '
}

# Print running Capsules visible to one container engine.
list_engine_capsules() {
  local engine="$1"
  local target="$2"
  local resolve_local_user="${3:-1}"
  local ps_format=""
  local ps_output=""
  local row=""
  local container_id=""
  local host_workdir=""
  local host_user=""
  local host_uid=""
  local list_row=""

  ps_format='{{.ID}}{{"\t"}}{{.Names}}{{"\t"}}{{.RunningFor}}'
  ps_format="${ps_format}"'{{"\t"}}{{.Image}}{{"\t"}}{{.Status}}'
  ps_format="${ps_format}"'{{"\t"}}{{.Ports}}'

  if ! ps_output="$(
    "$engine" ps --format "$ps_format" 2>&1
  )"; then
    warn "cannot query $engine containers: $ps_output"
    return 1
  fi

  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    container_id="${row%%$'\t'*}"
    if ! host_workdir="$(container_env_value \
      "$engine" "$container_id" CAPSULE_HOST_WORKDIR)"; then
      continue
    fi
    [[ -n "$host_workdir" ]] || continue
    host_uid="$(container_env_value \
      "$engine" "$container_id" CAPSULE_UID || true)"
    host_user="$(resolve_host_user "$host_uid" "$resolve_local_user")"
    list_row="$target"$'\t'"$engine"$'\t'"${host_user:-unknown}"
    list_row+=$'\t'"$row"$'\t'"$host_workdir"
    CAPSULE_LIST_ROWS+=("$list_row")
  done <<<"$ps_output"
}

# Print running Apple container Capsules. The JSON is filtered in one pipe,
# so neither it nor any other environment value lands in a traced variable.
list_apple_capsules() {
  local filter=""
  local rows=""
  local line=""
  local host_user=""

  # Emit "UID<US>ID NAME STARTED IMAGE STATE PORTS HOST_DIR" as TSV. The
  # dollar signs are jq syntax, not shell expansions.
  # shellcheck disable=SC2016
  filter='
    def env_value($key):
      (.configuration.initProcess.environment // [])
      | map(select(startswith($key + "=")))
      | (first // "") | ltrimstr($key + "=");
    .[]
    | select(env_value("CAPSULE_HOST_WORKDIR") != "")
    | "\(env_value("CAPSULE_UID"))\u001f\([
        .configuration.id,
        .configuration.id,
        (.status.startedDate // ""),
        (.configuration.image.reference // ""),
        (.status.state // ""),
        ((.configuration.publishedPorts // [])
          | map("\(.hostAddress // "0.0.0.0"):\(.hostPort)->"
            + "\(.containerPort)/\(.proto // "tcp")")
          | join(", ")),
        env_value("CAPSULE_HOST_WORKDIR")
      ] | @tsv)"
  '

  if ! rows="$(container ls --format json | jq -r "$filter")"; then
    return 1
  fi

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    host_user="$(resolve_host_user "${line%%$'\x1f'*}")"
    CAPSULE_LIST_ROWS+=(
      "local"$'\t'"apple"$'\t'"${host_user:-unknown}"$'\t'"${line#*$'\x1f'}"
    )
  done <<<"$rows"
}

# List Apple container Capsules when selected. Under "auto" this happens only
# on a Mac whose container service runs, so other hosts stay quiet.
list_selected_apple_capsules() {
  local reason=""

  reason="$(apple_host_reason)"
  if ! command -v jq >/dev/null 2>&1; then
    reason="${reason:-jq is not installed}"
  fi
  if [[ -n "$reason" ]]; then
    if [[ "$RUNTIME_SELECTION" == "apple" ]]; then
      die "cannot list apple Capsules: $reason"
    fi
    return 1
  fi

  if list_apple_capsules; then
    return 0
  fi
  if [[ "$RUNTIME_SELECTION" == "apple" ]]; then
    die 'failed to query running Capsules with apple'
  fi
  warn 'cannot query apple containers'
  return 1
}

# List local Capsules from selected engines, or Docker Capsules remotely.
list_running_capsules() {
  local queried=0
  local engine=""
  local engines=()
  local target=""
  local resolve_local_user=1

  if [[ -n "$REMOTE_HOST" ]]; then
    if [[ "$RUNTIME_SELECTION" == "podman" ]] || \
      [[ "$RUNTIME_SELECTION" == "apple" ]]; then
      warn "remote listing uses Docker; ignoring --runtime $RUNTIME_SELECTION"
    fi
    if ! command -v docker >/dev/null 2>&1; then
      die 'docker is required to query a remote host'
    fi
    export DOCKER_HOST="ssh://$REMOTE_HOST"
    list_engine_capsules docker "$REMOTE_HOST" 0 || \
      die "failed to query running Capsules on $REMOTE_HOST"
    print_capsule_list
    return
  fi

  case "$RUNTIME_SELECTION" in
    auto) engines=(docker podman) ;;
    docker) engines=(docker) ;;
    podman) engines=(podman) ;;
    apple) engines=() ;;
  esac

  for engine in ${engines[@]+"${engines[@]}"}; do
    if ! command -v "$engine" >/dev/null 2>&1; then
      if [[ "$RUNTIME_SELECTION" != "auto" ]]; then
        die "$engine is required by --runtime $RUNTIME_SELECTION"
      fi
      continue
    fi
    target="local"
    resolve_local_user=1
    if [[ "$engine" == "docker" ]]; then
      target="$(docker_list_target)"
      [[ "$target" == "local" ]] || resolve_local_user=0
    fi
    if list_engine_capsules "$engine" "$target" "$resolve_local_user"; then
      queried=1
    elif [[ "$RUNTIME_SELECTION" != "auto" ]]; then
      die "failed to query running Capsules with $engine"
    fi
  done

  case "$RUNTIME_SELECTION" in
    apple|auto)
      if list_selected_apple_capsules; then
        queried=1
      fi
      ;;
  esac

  if [[ "$queried" -eq 0 ]]; then
    die 'no usable container runtime found'
  fi

  print_capsule_list
}

main() {
  initialize_runtime_state
  parse_args "$@"
  apply_remote_env
  list_running_capsules
}

main "$@"
